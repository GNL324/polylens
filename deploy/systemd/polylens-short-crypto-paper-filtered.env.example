# Optional filtered paper strategy for out-of-sample testing.
# Copy to polylens-short-crypto-paper.env or use as a systemd drop-in override.
# Does not enable live trading.

PYTHONPATH=/home/noel/polylens
POLYLENS_LIVE_TRADING=false
POLYLENS_AUTONOMOUS_CRYPTO=false
POLYLENS_KALSHI_LIVE_SENDS_ENABLED=false
POLYLENS_POLYMARKET_LIVE_SENDS_ENABLED=false

# Paper strategy filters (read by short-crypto-paper-run when CLI flags are omitted)
POLYLENS_PAPER_DIRECTIONS=down
POLYLENS_PAPER_MAX_MODEL_PROBABILITY=0.55
POLYLENS_PAPER_MAX_ENTRY_PRICE=0.50
POLYLENS_PAPER_REQUIRE_VOLATILITY_ABOVE_MEDIAN=false
POLYLENS_PAPER_STRATEGY_LABEL=down_ask50_prob55

# Example filtered ExecStart (override in a systemd drop-in):
# /home/noel/.venv/bin/python -m src.cli short-crypto-paper-run \
#   --venues polymarket --assets BTC --windows 5 --max-trades 3 --min-edge -1 \
#   --directions down --max-model-probability 0.55 --max-entry-price 0.50 \
#   --strategy-label down_ask50_prob55 --json
