# Polylens prop arbitrage analytics collector
# Copy to polylens-prop-arb-collector.env and set API keys.
# Analytics collection only. No live betting or alerting.

PYTHONPATH=/home/noel/polylens
POLYLENS_LIVE_TRADING=false
POLYLENS_AUTONOMOUS_CRYPTO=false
POLYLENS_KALSHI_LIVE_SENDS_ENABLED=false
POLYLENS_POLYMARKET_LIVE_SENDS_ENABLED=false

# Required for provider=all
ODDS_API_KEY=
ODDSBLAZE_API_KEY=

# Optional overrides (service command defaults shown in polylens-prop-arb-collector.service)
POLYLENS_PROP_ARB_COLLECTOR_PROVIDER=all
POLYLENS_PROP_ARB_COLLECTOR_DB_PATH=/home/noel/polylens/data/opportunities.db
