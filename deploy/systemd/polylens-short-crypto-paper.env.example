# Polylens short crypto paper trading configuration
# Copy this file to polylens-short-crypto-paper.env and edit local paper-only settings.
# Do not put live-trading enable flags in this file.

PYTHONPATH=/home/noel/polylens
POLYLENS_LIVE_TRADING=false
POLYLENS_AUTONOMOUS_CRYPTO=false
POLYLENS_KALSHI_LIVE_SENDS_ENABLED=false
POLYLENS_POLYMARKET_LIVE_SENDS_ENABLED=false

# Paper runner stores results in data/short_crypto_paper.db by default.
# The systemd service command intentionally uses paper-only CLI commands.
#
# Optional paper strategy filters (used when CLI flags are omitted):
# POLYLENS_PAPER_DIRECTIONS=down
# POLYLENS_PAPER_MAX_MODEL_PROBABILITY=0.55
# POLYLENS_PAPER_MAX_ENTRY_PRICE=0.50
# POLYLENS_PAPER_MIN_ENTRY_PRICE=0.40
# POLYLENS_PAPER_REQUIRE_VOLATILITY_ABOVE_MEDIAN=true
# POLYLENS_PAPER_STRATEGY_LABEL=down_ask50_prob55
#
# See deploy/systemd/polylens-short-crypto-paper-filtered.env.example for a filtered strategy template.
