# Polylens Kalshi market recorder configuration
# Copy this file to kalshi-market-recorder.env and edit values locally.
# The real .env file is intentionally untracked.

KALSHI_RECORDER_ASSETS=BTC,ETH,SOL
KALSHI_RECORDER_MARKET_TYPES=crypto
KALSHI_RECORDER_INTERVAL=60
KALSHI_RECORDER_LIMIT=50
KALSHI_RECORDER_DISCOVERY_LIMIT=500
KALSHI_RECORDER_DB_PATH=data/kalshi_market_data.db

# Keep trading disabled. The recorder only uses public read-only market data.
LIVE_TRADING=false
DRY_RUN=true
