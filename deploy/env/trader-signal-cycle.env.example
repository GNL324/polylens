# Polylens read-only trader signal cycle configuration
# Copy this file to trader-signal-cycle.env and edit local read-only settings.
# Do not put live-trading enable flags in this file.

PYTHONPATH=/home/noel/polylens
POLYLENS_LIVE_TRADING=false
POLYLENS_AUTONOMOUS_CRYPTO=false
POLYLENS_KALSHI_LIVE_SENDS_ENABLED=false
POLYLENS_POLYMARKET_LIVE_SENDS_ENABLED=false

# Optional activity/outcomes inputs for the read-only cycle command.
# When omitted, the cycle still runs safely against an empty or existing DB.
# TRADER_SIGNAL_ACTIVITY_PATH=/home/noel/polylens/data/exports/wallet_activity.json
# TRADER_SIGNAL_OUTCOMES_PATH=/home/noel/polylens/data/exports/trader_signal_outcomes.json
# TRADER_SIGNAL_DB_PATH=/home/noel/polylens/data/trader_signals.db
